{
	"name": "design-embed",
	"version": "0.1.1",
	"type": "module",
	"private": false,
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md"
	],
	"bin": {
		"design-embed": "./dist/cli.mjs"
	},
	"scripts": {
		"test": "node --conditions=development --test src/**/*.test.ts",
		"dev": "node src/cli.ts",
		"compile:react": "node src/cli.ts react",
		"compile:html": "node src/cli.ts html",
		"compile:vanjs": "node src/cli.ts vanjs",
		"get-raw": "node src/cli.ts raw"
	},
	"devDependencies": {
		"@design-embed/config": "workspace:*",
		"@design-embed/core": "workspace:*"
	}
}
