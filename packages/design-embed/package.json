{
	"name": "design-embed",
	"version": "0.2.0",
	"type": "module",
	"private": false,
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md"
	],
